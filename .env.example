# Copy to .env (git-ignored) and fill in. No real secrets, URLs or credentials belong in this file.
NODE_ENV=development
PORT=3000

# REIS (all five required). REIS_BASE_URL is https; TLS validation is always on
# (bank CA: NODE_EXTRA_CA_CERTS=/etc/kyc/aiib-ca.pem in the systemd unit).
REIS_BASE_URL=
REIS_TENANT=
REIS_USERNAME=
REIS_PASSWORD=
REIS_TIMEOUT_MS=
# Optional, default Flexcube.
REIS_SYSTEM_NAME=

# Webhook POST /customerStatus. 'bearer': REIS sends "Authorization: Bearer <WEBHOOK_BEARER_TOKEN>".
# Unset = every callback is rejected. Token >= 32 chars, generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEBHOOK_SECURITY_MODE=
WEBHOOK_BEARER_TOKEN=

# Local database of the integration layer (cases, callback audit, reference mappings).
DB_TYPE=sqlite
DB_SQLITE_PATH=

# FLEXCUBE Oracle database (all three together). host:port/SERVICE_NAME.
FLEXCUBE_DB_USER=
FLEXCUBE_DB_PASSWORD=
FLEXCUBE_DB_CONNECT_STRING=
# Optional: schema owning the FLEXCUBE tables when the user has no synonyms.
FLEXCUBE_DB_SCHEMA=
# Optional, default STTM_KYC_REIS_PAYLOAD_CUSTOM.
FLEXCUBE_STAGING_TABLE=

# Polling of the trigger table STTM_CUSTOMER_CUSTOM (READY_TO_SCAN = U). Off unless 'true'.
FLEXCUBE_POLL_ENABLED=
# Pause between two passes in ms (default 10000, minimum 1000).
FLEXCUBE_POLL_INTERVAL_MS=
# CIF revisions per pass (default 20, 1-200).
FLEXCUBE_POLL_BATCH_SIZE=
# Optional cut-off: only KYCs with STTM_KYC_MASTER.MAKER_DT_STAMP on / after this date are sent
# (2026-11-16 or 2026-11-16T08:00:00, database clock). Empty = every U row of the trigger table.
FLEXCUBE_SYNC_START_DATE=
# Retries of a failed send (REIS not reached, token refused, timeout, 5xx): attempts per CIF revision
# (default 5) and the wait between two attempts in ms (default 60000). Then staging E and trigger E.
FLEXCUBE_SYNC_MAX_ATTEMPTS=
FLEXCUBE_SYNC_RETRY_DELAY_MS=
# Optional: only these CIFs (comma separated). Empty = every CIF FCUBS sets to U.
FLEXCUBE_SYNC_CIF_ALLOWLIST=
# Optional: PROCESS_STATUS of a claimed row (default W) and the key-person type column
# of STTM_KYC_CORP_KEYPERSONS_CUSTOM (default KYC_KEYPERSON_TYPE).
FLEXCUBE_STAGING_STATUS_IN_PROGRESS=
FLEXCUBE_KEYPERSON_TYPE_COLUMN=
