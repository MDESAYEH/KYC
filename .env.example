# Example only. Copy to .env (git-ignored) and fill in real values via your secret store.
# No real secrets, URLs or credentials belong in this file.
NODE_ENV=development
PORT=3000

# REIS (values supplied by the bank / REIS team)
REIS_BASE_URL=
REIS_TENANT=
REIS_USERNAME=
REIS_PASSWORD=
REIS_TIMEOUT_MS=
# Optional. REIS systemName sent on every request (default: Flexcube).
REIS_SYSTEM_NAME=
# All five REIS_* values are required at startup. REIS_TIMEOUT_MS is a positive integer (ms).
# REIS_BASE_URL must be https in production. TLS certificate validation is always on.

# Webhook security for POST /customerStatus (agreed with Reis, V1.4: BEARER).
# 'bearer'           -> Reis must send "Authorization: Bearer <WEBHOOK_BEARER_TOKEN>".
#                       The token is a long random secret (>= 32 chars) shared with Reis over a
#                       separate secure channel, never by plain email.
# 'unrestricted-dev' -> development/test only; refused in production.
# Unset = every callback is rejected (safe default). Any other value stops startup.
WEBHOOK_SECURITY_MODE=
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEBHOOK_BEARER_TOKEN=
WEBHOOK_API_KEY=
WEBHOOK_IP_ALLOWLIST=

# Persistence - production database is TBD. sqlite is for local dev/test only.
DB_TYPE=sqlite
# Local dev/test only (default ./var/kyc-local.sqlite outside production). Use :memory: for throwaway runs.
DB_SQLITE_PATH=

# Retry policy - TBD, configurable
RETRY_MAX_ATTEMPTS=
RETRY_BASE_DELAY_MS=

# FLEXCUBE -> Integration API authentication - TBD

# FLEXCUBE Oracle database (UAT1 / PROD), used to write the staging table
# STTM_KYC_REIS_PAYLOAD_CUSTOM (REIS_FINAL_STATUS = APPROVED / BLOCKED).
# All three are set together. Unset = in-memory MOCK updater (development/test only);
# production refuses to start without them. Connect string: host:port/SERVICE_NAME.
FLEXCUBE_DB_USER=
FLEXCUBE_DB_PASSWORD=
FLEXCUBE_DB_CONNECT_STRING=
# Optional: schema owning the FLEXCUBE tables when the user has no synonyms (e.g. FCUBS).
FLEXCUBE_DB_SCHEMA=
# Optional, default STTM_KYC_REIS_PAYLOAD_CUSTOM (may be schema-qualified).
FLEXCUBE_STAGING_TABLE=
# Poll FLEXCUBE for open KYCs without a staging row (any AUTH_STAT) and send them to REIS. Off unless 'true';
# requires the FLEXCUBE_DB_* settings above. Interval 60000-300000 ms (default 120000),
# batch 1-200 KYCs per pass (default 20).
FLEXCUBE_POLL_ENABLED=
FLEXCUBE_POLL_INTERVAL_MS=
FLEXCUBE_POLL_BATCH_SIZE=
# MANDATORY when polling is enabled (startup fails without it): only KYCs with
# STTM_KYC_MASTER.MAKER_DT_STAMP on / after this ISO date or timestamp are sent, e.g. 2026-11-16 or
# 2026-11-16T08:00:00 (no time-zone suffix: compared with the database clock).
FLEXCUBE_SYNC_START_DATE=
# Staging PROCESS_STATUS of a claimed row (default W). One uppercase letter; follow Finexta's CHECK
# constraint on the staging table. The claim stays conditional (only from N).
FLEXCUBE_STAGING_STATUS_IN_PROGRESS=
# Column of STTM_KYC_CORP_KEYPERSONS_CUSTOM holding the party type I / C (default KYC_KEYPERSON_TYPE;
# UAT1: exists in the CUSTOM table, not in STTM_KYC_CORP_KEYPERSONS). Change only if Finexta says otherwise.
FLEXCUBE_KEYPERSON_TYPE_COLUMN=
