{
  "name": "kyc-integration-api",
  "version": "0.1.0",
  "private": true,
  "description": "Bank Integration API between Oracle FLEXCUBE and REIS KYC (KYC scope only)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "migration:run": "nest build && node dist/persistence/run-migrations.js",
    "migration:revert": "nest build && node dist/persistence/run-migrations.js revert",
    "test": "jest",
    "test:cov": "jest --coverage",
    "mappings:seed": "nest build && node dist/mapping/seed/run-seed.js",
    "check:uat1": "nest build && node dist/tools/check-flexcube-uat.js",
    "reconcile:staging": "nest build && node dist/tools/reconcile-staging.js",
    "staging:requeue": "nest build && node dist/tools/reconcile-staging.js",
    "backup:sqlite": "nest build && node dist/tools/backup-sqlite.js",
    "trial:one": "nest build && node dist/tools/run-single-kyc-trial.js",
    "trial:reset": "nest build && node dist/tools/reset-single-kyc-trial.js",
    "discover:uat1": "node dist/tools/run-readonly-discovery.js",
    "check:oracle-sql": "nest build && node dist/tools/check-oracle-sql.js"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "oracledb": "^6.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/oracledb": "^6.10.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0"
  }
}
